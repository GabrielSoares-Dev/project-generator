#!/bin/sh
set -eu

usage() {
  echo "usage: agents-sync --project DIR [--check] [--source DIR]" >&2
  exit 2
}

fail() {
  echo "agents-sync: $*" >&2
  exit 1
}

SRC=$(cd "$(dirname "$0")/.." && pwd)
PROJECT=""
CHECK=0
while [ $# -gt 0 ]; do
  case $1 in
    --project) [ $# -ge 2 ] || usage; PROJECT=$2; shift 2 ;;
    --source) [ $# -ge 2 ] || usage; SRC=$2; shift 2 ;;
    --check) CHECK=1; shift ;;
    *) usage ;;
  esac
done
[ -n "$PROJECT" ] || usage
[ -d "$PROJECT" ] || fail "project folder not found: $PROJECT"
[ -d "$SRC/roles" ] || fail "no roles/ in source: $SRC"
PROJECT=$(cd "$PROJECT" && pwd)
SRC=$(cd "$SRC" && pwd)

MANIFEST=.agents/agent-team.manifest
SECTIONS="Mission Inputs Steps Outputs Labels Never"
READ_ONLY_TOOLS="Read, Grep, Glob, mcp__github__pull_request_read, mcp__github__issue_read, mcp__github__pull_request_review_write, mcp__github__add_comment_to_pending_review, mcp__github__add_issue_comment, mcp__github__update_issue_comment"

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT INT TERM
OUT="$TMP/out"
mkdir -p "$OUT"

field() {
  awk -v key="$1" '
    NR == 1 && $0 != "---" { exit }
    NR > 1 && $0 == "---" { exit }
    NR > 1 {
      i = index($0, ":")
      if (i && substr($0, 1, i - 1) == key) {
        v = substr($0, i + 1)
        sub(/^[ \t]+/, "", v)
        sub(/[ \t]+$/, "", v)
        print v
        exit
      }
    }
  ' "$2"
}

body() {
  awk 'NR == 1 { next } !done && $0 == "---" { done = 1; next } done { print }' "$1" | sed '/./,$!d'
}

has_frontmatter() {
  [ "$(head -n 1 "$1")" = "---" ] && [ "$(awk 'NR > 1 && $0 == "---" { print "yes"; exit }' "$1")" = "yes" ]
}

check_sections() {
  missing=$(body "$1" | awk -v want="$SECTIONS" '
    BEGIN { n = split(want, s, " "); i = 1 }
    i <= n && $0 == "## " s[i] { i++ }
    END { if (i <= n) print s[i] }
  ')
  [ -z "$missing" ] || fail "$2: section '## $missing' missing or out of order"
}

quote() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

instructions() {
  body "$1"
  if [ -f "$2" ]; then
    printf '\n## Additions for this project\n\n'
    sed '/./,$!d' "$2"
  fi
}

render_role() {
  file=$1
  rel="roles/$(basename "$file")"
  has_frontmatter "$file" || fail "$rel: no frontmatter"
  name=$(field name "$file")
  description=$(field description "$file")
  capability=$(field capability "$file")
  [ -n "$name" ] || fail "$rel: no name"
  [ "$name.md" = "$(basename "$file")" ] || fail "$rel: name '$name' does not match the file name"
  [ -n "$description" ] || fail "$rel: no description"
  case $capability in
    read-only) sandbox=read-only ;;
    tests-only|full) sandbox=workspace-write ;;
    *) fail "$rel: capability must be read-only, tests-only or full" ;;
  esac
  check_sections "$file" "$rel"

  override="$PROJECT/agents/overrides/$name.md"
  instructions "$file" "$override" > "$TMP/instructions"
  if grep -q "'''" "$TMP/instructions"; then
    fail "$rel: contains ''' which cannot be rendered into TOML"
  fi
  header="Generated by agent-team bin/agents-sync from $rel. Do not edit: change the source and run the sync."

  mkdir -p "$OUT/.claude/agents" "$OUT/.codex/agents"
  {
    echo "---"
    echo "name: $name"
    echo "description: \"$(quote "$description")\""
    if [ "$capability" = read-only ]; then
      echo "tools: $READ_ONLY_TOOLS"
    fi
    echo "---"
    echo
    echo "<!-- $header -->"
    echo
    cat "$TMP/instructions"
  } > "$OUT/.claude/agents/$name.md"
  {
    echo "# $header"
    echo
    echo "name = \"$name\""
    echo "description = \"$(quote "$description")\""
    echo "sandbox_mode = \"$sandbox\""
    echo "developer_instructions = '''"
    cat "$TMP/instructions"
    echo "'''"
  } > "$OUT/.codex/agents/$name.toml"
}

for role in "$SRC"/roles/*.md; do
  [ -f "$role" ] || fail "no roles in $SRC/roles"
  render_role "$role"
done

for override in "$PROJECT"/agents/overrides/*.md; do
  [ -f "$override" ] || continue
  [ -f "$SRC/roles/$(basename "$override")" ] || fail "override for an unknown role: agents/overrides/$(basename "$override")"
done

if [ -d "$SRC/skills" ]; then
  for skill in "$SRC"/skills/*/; do
    [ -d "$skill" ] || continue
    skill_name=$(basename "$skill")
    [ -f "$skill/SKILL.md" ] || fail "skills/$skill_name: no SKILL.md"
    for target in .claude/skills .agents/skills; do
      mkdir -p "$OUT/$target"
      cp -Rp "$skill" "$OUT/$target/$skill_name"
    done
  done
fi

(cd "$OUT" && find . -type f | sed 's|^\./||' | LC_ALL=C sort) > "$TMP/new"
mkdir -p "$OUT/.agents"
{
  echo "# Files written by agent-team bin/agents-sync. Do not edit."
  cat "$TMP/new"
} > "$OUT/$MANIFEST"
echo "$MANIFEST" >> "$TMP/new"
LC_ALL=C sort -o "$TMP/new" "$TMP/new"

if [ -f "$PROJECT/$MANIFEST" ]; then
  grep -v '^#' "$PROJECT/$MANIFEST" | LC_ALL=C sort > "$TMP/old" || true
  echo "$MANIFEST" >> "$TMP/old"
  LC_ALL=C sort -u -o "$TMP/old" "$TMP/old"
else
  : > "$TMP/old"
fi
LC_ALL=C comm -23 "$TMP/old" "$TMP/new" > "$TMP/stale"

if [ "$CHECK" -eq 1 ]; then
  problems=0
  while IFS= read -r path; do
    if [ ! -f "$PROJECT/$path" ]; then
      echo "missing: $path"
      problems=1
    elif ! cmp -s "$OUT/$path" "$PROJECT/$path"; then
      echo "differs: $path"
      problems=1
    fi
  done < "$TMP/new"
  while IFS= read -r path; do
    if [ -e "$PROJECT/$path" ]; then
      echo "stale: $path"
      problems=1
    fi
  done < "$TMP/stale"
  if [ "$problems" -ne 0 ]; then
    echo "agents-sync: rendered files are out of date; change the sources and run the sync" >&2
    exit 1
  fi
  echo "agents-sync: up to date"
  exit 0
fi

while IFS= read -r path; do
  if [ -f "$PROJECT/$path" ] && ! grep -qxF "$path" "$TMP/old" && ! cmp -s "$OUT/$path" "$PROJECT/$path"; then
    fail "would overwrite a file it does not manage: $path"
  fi
done < "$TMP/new"

while IFS= read -r path; do
  rm -f "$PROJECT/$path"
  dir=$(dirname "$PROJECT/$path")
  while [ "$dir" != "$PROJECT" ] && rmdir "$dir" 2>/dev/null; do
    dir=$(dirname "$dir")
  done
done < "$TMP/stale"

while IFS= read -r path; do
  mkdir -p "$(dirname "$PROJECT/$path")"
  cp -p "$OUT/$path" "$PROJECT/$path"
done < "$TMP/new"

echo "agents-sync: $(wc -l < "$TMP/new" | tr -d ' ') files written, $(wc -l < "$TMP/stale" | tr -d ' ') removed"
